# Kiwi backend (not the kiwi-ui frontend, which commonly runs on :3001).
KIWI=http://localhost:3000

# Must exactly match the URL that serves this directory.
APP_URL=http://localhost:8000/
SLUG=explorable
TAB_LABEL=Explorables
PROMPT_ID=explorable-build

# Required for the initial whitelist entry and public registration. Keep this
# value aligned with the existing whitelist entry when SKIP_WHITELIST=1.
SECRET=replace-with-a-unique-registration-secret-of-at-least-32-characters

# Set the class that should expose the app as a tab.
CLASS_ID=

# Choose one administrator authentication method. Do not commit this file.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_TOKEN=
# SESSION_COOKIE=connect.sid=s%3A...

# Set to 1 only when the whitelist entry already exists and uses SECRET above.
# SKIP_WHITELIST=1